        "archived": false,
        "groups": [
          {
            "items": [
              {
                "description": "生成技术方案前会识别前端、后端、CLI、移动端、桌面端、SDK、DevOps、本地系统服务等项目领域，只展开与本次变更相关的设计内容",
                "name": "领域感知方案设计",
              },
              {
                "description": "从范围、架构、接口、数据、UI、性能、安全、兼容、验证等 14 个维度按需选择重点，关键设计充分展开，次要内容只做检查，不相关内容直接跳过",
                "name": "按风险选择设计维度",
              },
            ],
            "label": "新能力",
            "type": "feat",
          },
          {
            "items": [
              {
                "description": "方案开头用简短摘要说明重点覆盖和跳过的维度，减少大而全的表格与无关方法论，让文档更容易阅读和落地",
                "name": "设计关注点精简",
              },
              {
                "description": "评审页中的时序、状态、数据流和模块依赖图默认使用 Mermaid，仅在系统、基础设施、云、网络或安全拓扑等复杂场景加载架构图能力，减少普通评审的上下文与 token 消耗",
                "name": "human-review 图表按需生成",
              },
            ],
            "label": "优化",
            "type": "refactor",
          },
