{
  "name": "devkeel-web",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:server": "tsx watch server.ts --source-versions",
    "start": "node --import tsx server.ts",
    "build": "tsc --noEmit && vite build && tsx scripts/verify-versions-build.ts",
    "package:app": "node scripts/package-app.js",
    "test": "vitest run",
    "preview": "pnpm build && pnpm start"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "hono": "^4.7.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MinLeeV5/devkeel.git",
    "directory": "web"
  },
  "homepage": "https://github.com/MinLeeV5/devkeel#readme",
  "bugs": {
    "url": "https://github.com/MinLeeV5/devkeel/issues"
  },
  "private": true
}
